/-!
# Sheaf statements as a client writes them: fixtures

These fixtures state results of `TDA.Sheaf` as a client of the library writes them: through
public declarations and library instances, with decidability supplied explicitly where a statement
needs it. The only local instances are Mathlib's `HasDerivedCategory.standard` and the library
theorems `hasExt_sheaf_realLine` and `hasExt_diagram`, installed with `attribute [local instance]`
in the sections that use them.

* **Orthant topology.** `rw [eq_generateFrom]` rewrites the topology of `WithOrthant 2` in a goal
  (`isOpen_of_isOpen_generateFrom_orthant`) and in a hypothesis (`isOpen_generateFrom_orthant`);
  the form with left side `inferInstance` follows (`inferInstance_eq_generateFrom`).
* **Diagrams on `Fin 2 → ℝ`.** Under `open scoped TDA.Persistence`, `ephemeral_orthantBasis_iff`
  and `isZero_orthantQ_iff` apply to a functor and to a `PModule` on `Fin 2 → ℝ`
  (`ephemeral_orthantBasis_iff_two`, `isZero_orthantQ_iff_two`); without the scope the maps are
  written through `TDA.Persistence.structureMap` (`isZero_orthantQ_iff_structureMap`).
* **Strata and stalks for the breakpoints `q2 = ![0, 1]`.** `rw [stratum_odd_of_val …]` at the
  literal vertex `3` (`stratum_q2_three`). `finrank_stalk_extension_interval` with the
  decidability instance `decidableMemJc`, which decides membership in `intervalSet q2 Jc = [0, 1]`
  through `decidable_of_iff`: dimension `1` at `1/2` (`finrank_stalk_Jc_half`) and `0` at `2`
  (`finrank_stalk_Jc_two`); an instance decided by a hypothesis
  (`finrank_stalk_extension_interval_of_mem`), and the form with `Classical.propDecidable`
  (`finrank_stalk_extension_interval_classical`).
* **Barcodes of sections.** `barcode_sections_extension_interval` and
  `barcode_sections_barcodeSheaf` stated without a local instance
  (`barcode_sections_extension_Jc`, `barcode_sections_barcodeSheaf_Jc_Jco`), and the graded
  barcode of the interval sheaf of `[0, 1]` in degree `1` (`gradedBarcode_singleFunctor_Jc`).
* **`Ext`.** With the two `HasExt` theorems installed, `ext_representable_extension_eq_zero` for
  `Φ P_1` and the interval sheaf of `[0, 1]` (`ext_representable_extension_Jc`).
* **Base change and band functors.** `IsIso (baseChange ℚ w)` for the identity square of `ℝ` by
  `inferInstance` (`isIso_baseChange_id_realLine`); with `TDA.Sheaf` and
  `TDA.Sheaf.BandConvolution` both open, `realLine` is `TDA.Sheaf.realLine` (`realLine_eq`,
  `isGE_isLE_T_one`); `TCompOfEq` at the literal radius `2` (`TCompOneOne`).
-/

open CategoryTheory Limits TopologicalSpace

namespace TDA.Sheaf.ClientExamples

/-! ### The orthant topology -/

section OrthantTopology

open TDA.Sheaf.OrthantSheaf

/-- `rw [eq_generateFrom]` rewrites the topology of `WithOrthant 2` in the goal: a set open for
the topology generated by the orthants is open. -/
theorem isOpen_of_isOpen_generateFrom_orthant (S : Set (WithOrthant 2))
    (h : @IsOpen _ (generateFrom (SetLike.coe '' Set.range (orthant (n := 2)))) S) :
    IsOpen S := by
  rw [eq_generateFrom]
  exact h

/-- `rw [eq_generateFrom] at h` rewrites the topology of `WithOrthant 2` in a hypothesis: an open
set is open for the topology generated by the orthants. -/
theorem isOpen_generateFrom_orthant (S : Set (WithOrthant 2)) (h : IsOpen S) :
    @IsOpen _ (generateFrom (SetLike.coe '' Set.range (orthant (n := 2)))) S := by
  rwa [eq_generateFrom] at h

/-- `eq_generateFrom` with left side the instance found by `inferInstance`. -/
theorem inferInstance_eq_generateFrom (n : ℕ) :
    (inferInstance : TopologicalSpace (WithOrthant n)) =
      generateFrom (SetLike.coe '' Set.range (orthant (n := n))) :=
  eq_generateFrom

end OrthantTopology

/-! ### Diagrams on `Fin 2 → ℝ` -/

section OrthantDiagrams

open TDA.Sheaf.OrthantSheaf
open scoped TDA.Persistence

/-- Under `open scoped TDA.Persistence`, `ephemeral_orthantBasis_iff` applies to a functor on
`Fin 2 → ℝ`. -/
theorem ephemeral_orthantBasis_iff_two (M : (Fin 2 → ℝ) ⥤ ModuleCat.{0} ℚ) :
    (orthantBasis 2).ephemeral (ModuleCat.{0} ℚ) M ↔
      ∀ (x y : Fin 2 → ℝ) (h : ∀ i, x i < y i), M.map (homOfLE fun i => (h i).le) = 0 :=
  ephemeral_orthantBasis_iff M

/-- Under `open scoped TDA.Persistence`, `isZero_orthantQ_iff` applies to a persistence module on
`Fin 2 → ℝ`. -/
theorem isZero_orthantQ_iff_two (M : TDA.Persistence.PModule ℚ (Fin 2 → ℝ)) :
    IsZero (((orthantBasis 2).Q (ModuleCat.{0} ℚ)).obj M) ↔
      ∀ (x y : Fin 2 → ℝ) (h : ∀ i, x i < y i), M.map (homOfLE fun i => (h i).le) = 0 :=
  isZero_orthantQ_iff M

end OrthantDiagrams

section OrthantStructureMap

/-- Without `open scoped TDA.Persistence`, `isZero_orthantQ_iff` applies to a persistence module
on `Fin 2 → ℝ` with its maps written through `TDA.Persistence.structureMap`. -/
theorem isZero_orthantQ_iff_structureMap (M : TDA.Persistence.PModule ℚ (Fin 2 → ℝ)) :
    IsZero (((TDA.Sheaf.OrthantSheaf.orthantBasis 2).Q (ModuleCat.{0} ℚ)).obj M) ↔
      ∀ (x y : Fin 2 → ℝ) (h : ∀ i, x i < y i),
        TDA.Persistence.structureMap M (fun i => (h i).le) = 0 :=
  TDA.Sheaf.OrthantSheaf.isZero_orthantQ_iff M

end OrthantStructureMap

/-! ### Strata and stalks on the real line -/

section RealLine

open TDA.Sheaf.AlternatingDiagram TDA.Sheaf.RealStratification TDA.Sheaf.RealConstructible

/-- The two breakpoints `0 < 1`; the strata path has the five vertices `0, …, 4`. -/
noncomputable def q2 : Fin 2 → ℝ := ![0, 1]

/-- The breakpoints `q2` are strictly increasing. -/
theorem q2_strictMono : StrictMono q2 := by
  refine Fin.strictMono_iff_lt_succ.2 fun i => ?_
  fin_cases i
  simp [q2]

/-- The vertices `1, 2, 3` of the strata path of `q2`: the closed interval `[0, 1]`. -/
def Jc : TDA.Persistence.FiniteInterval (2 * 2 + 1) := ⟨1, 4, by decide, by decide⟩

/-- The vertices `1, 2` of the strata path of `q2`: the interval `[0, 1)`. -/
def Jco : TDA.Persistence.FiniteInterval (2 * 2 + 1) := ⟨1, 3, by decide, by decide⟩

/-- `rw [stratum_odd_of_val]` at the literal vertex `3`: its stratum is the breakpoint `1`. -/
theorem stratum_q2_three : stratum q2 3 = {1} := by
  rw [stratum_odd_of_val q2_strictMono 1 rfl]
  simp [q2]

/-- The interval set of `Jc` is `[0, 1]`. -/
theorem intervalSet_q2_Jc : intervalSet q2 Jc = Set.Icc 0 1 := by
  rw [intervalSet_eq_Icc q2_strictMono (i := 0) (j := 1) rfl rfl]
  simp [q2]

/-- Membership in `intervalSet q2 Jc`, decided as membership in `[0, 1]`. -/
noncomputable def decidableMemJc (x : ℝ) : Decidable (x ∈ intervalSet q2 Jc) :=
  decidable_of_iff (0 ≤ x ∧ x ≤ 1) (by rw [intervalSet_q2_Jc, Set.mem_Icc])

/-- With the instance `decidableMemJc`, `finrank_stalk_extension_interval` and `rw` give
dimension `1` at `1/2`, after `rw`. -/
theorem finrank_stalk_Jc_half :
    Module.finrank ℚ (((extension ℚ q2_strictMono).obj (interval (orient 2) Jc)).presheaf.stalk
      (1 / 2 : ℝ)) = 1 := by
  let _ := decidableMemJc (1 / 2)
  have h : (1 / 2 : ℝ) ∈ intervalSet q2 Jc := by
    rw [intervalSet_q2_Jc]
    norm_num
  rw [finrank_stalk_extension_interval, ite_eq_left_iff]
  exact fun h' => absurd h h'

/-- With the instance `decidableMemJc`, `finrank_stalk_extension_interval` and `simp` give
dimension `0` at `2`. -/
theorem finrank_stalk_Jc_two :
    Module.finrank ℚ (((extension ℚ q2_strictMono).obj (interval (orient 2) Jc)).presheaf.stalk
      (2 : ℝ)) = 0 := by
  let _ := decidableMemJc 2
  norm_num [finrank_stalk_extension_interval, intervalSet_q2_Jc]

/-- A decidability instance from a membership hypothesis: the stalk has dimension `1`. -/
theorem finrank_stalk_extension_interval_of_mem {m : ℕ} {p : Fin m → ℝ} (hp : StrictMono p)
    (J : TDA.Persistence.FiniteInterval (2 * m + 1)) {x : ℝ} (hx : x ∈ intervalSet p J) :
    Module.finrank ℚ (((extension ℚ hp).obj (interval (orient m) J)).presheaf.stalk x) = 1 := by
  let _ : Decidable (x ∈ intervalSet p J) := isTrue hx
  simp [finrank_stalk_extension_interval, hx]

/-- `finrank_stalk_extension_interval` with the classical decidability instance
`Classical.propDecidable` supplied as an argument. -/
theorem finrank_stalk_extension_interval_classical (k : Type) [Field k] {m : ℕ}
    {p : Fin m → ℝ} (hp : StrictMono p) (J : TDA.Persistence.FiniteInterval (2 * m + 1)) (x : ℝ) :
    Module.finrank k (((extension k hp).obj (interval (orient m) J)).presheaf.stalk x) =
      @ite ℕ (x ∈ intervalSet p J) (Classical.propDecidable _) 1 0 :=
  by classical exact finrank_stalk_extension_interval k hp J x

/-- `barcode_sections_extension_interval` stated without a local instance. -/
theorem barcode_sections_extension_Jc :
    barcode ((sections ℚ q2).obj ((extension ℚ q2_strictMono).obj (interval (orient 2) Jc))) =
      {Jc} :=
  barcode_sections_extension_interval ℚ q2_strictMono Jc

/-- `barcode_sections_barcodeSheaf` stated without a local instance. -/
theorem barcode_sections_barcodeSheaf_Jc_Jco :
    barcode ((sections ℚ q2).obj (barcodeSheaf ℚ q2_strictMono {Jc, Jco})) = {Jc, Jco} :=
  barcode_sections_barcodeSheaf ℚ q2_strictMono _

section Derived

attribute [local instance] HasDerivedCategory.standard

/-- The interval sheaf of `[0, 1]` is constructible for the breakpoints `q2`. -/
theorem isConstructible_Jc :
    IsConstructible (breakpoints q2) ((extension ℚ q2_strictMono).obj (interval (orient 2) Jc)) :=
  isConstructible_extension ℚ q2_strictMono fun _ => inferInstance

/-- The interval sheaf of `[0, 1]` in degree `1` has graded barcode `{Jc}` in degree `1`. -/
theorem gradedBarcode_singleFunctor_Jc :
    gradedBarcode ℚ q2_strictMono
        ((DerivedCategory.singleFunctor _ 1).obj
          ((extension ℚ q2_strictMono).obj (interval (orient 2) Jc)))
        (hasConstructibleCohomology_singleFunctor ℚ q2_strictMono isConstructible_Jc 1) 1 =
      {Jc} := by
  rw [gradedBarcode_singleFunctor ℚ q2_strictMono isConstructible_Jc]
  simpa using barcode_sections_extension_Jc

end Derived

section Ext

attribute [local instance] hasExt_sheaf_realLine hasExt_diagram

/-- With `hasExt_sheaf_realLine` and `hasExt_diagram` installed as local instances, `Ext¹` from
`Φ P_1` to the interval sheaf of `[0, 1]` vanishes. -/
theorem ext_representable_extension_Jc
    (e : Abelian.Ext ((extension ℚ q2_strictMono).obj (representable ℚ (orient 2) 1))
      ((extension ℚ q2_strictMono).obj (interval (orient 2) Jc)) (0 + 1)) :
    e = 0 :=
  ext_representable_extension_eq_zero ℚ q2_strictMono 1 _ 0 e

end Ext

end RealLine

/-! ### Base change and band functors -/

section Band

open TDA.Sheaf TDA.Sheaf.BandConvolution

attribute [local instance] HasDerivedCategory.standard

/-- The base-change morphism of the identity square of `ℝ` is an isomorphism, by instance
search. -/
theorem isIso_baseChange_id_realLine :
    IsIso (baseChange ℚ (show 𝟙 realLine ≫ 𝟙 realLine = 𝟙 realLine ≫ 𝟙 realLine from rfl)) :=
  inferInstance

/-- With `TDA.Sheaf` and `TDA.Sheaf.BandConvolution` open, `realLine` is the real line. -/
theorem realLine_eq : realLine = TopCat.of ℝ :=
  rfl

/-- A band statement on `realLine` with both namespaces open: `T ℚ 1` raises the upper degree
bound by one. -/
theorem isGE_isLE_T_one (M : DerivedCategory.Plus (realLine.Sheaf (ModuleCat.{0} ℚ)))
    [M.IsGE 0] [M.IsLE 0] :
    ((T ℚ 1).obj M).IsGE 0 ∧ ((T ℚ 1).obj M).IsLE (0 + 1) :=
  isGE_isLE_T_obj ℚ 1 M 0 0

/-- The composition isomorphism at the radii `(1, 1)` with target the literal radius `2`. -/
noncomputable def TCompOneOne : T ℚ 1 ⋙ T ℚ 1 ≅ T ℚ 2 :=
  TCompOfEq ℚ zero_le_one zero_le_one (by norm_num)

end Band

end TDA.Sheaf.ClientExamples
