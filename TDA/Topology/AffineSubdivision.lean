import TDA.Topology.SubdivisionDiameter
import Mathlib.Algebra.Group.Subgroup.Lattice
import Mathlib.Algebra.Homology.Homotopy

/-!
# Barycentric subdivision of affine chains

For a convex set `K` in the standard simplex `StdSimplex ℝ (Fin (m + 1))` and coefficients `R` in
a preadditive category with coproducts, `affineSubdivision hK R` is the barycentric subdivision
chain map on the affine chains `(affineSSet K).chainComplex R`. It is the identity in degree `0`,
and on an affine simplex `σ` of positive dimension it is the cone from the barycentre
`b_σ = simplexBarycenter hK σ` on the subdivision of the boundary,
`sd(σ) = b_σ · sd(∂σ)` (`ιChainComplex_affineSubdivision_f_succ`). On a segment `[v₀, v₁]` it
gives `[b, v₁] - [b, v₀]` (`ιChainComplex_affineSubdivision_f_one`). It is a chain map by the cone
boundary formulas `coneMap_d` and `coneMap_zero_d`, the latter with `d_comp_augmentation`.

`affineSubdivisionHomotopy hK R` is a homotopy from `affineSubdivision hK R` to the identity:
it is `0` in degree `0`, and on a simplex `σ` of positive dimension
`T(σ) = b_σ · (sd(σ) - σ - T(∂σ))` (`ιChainComplex_affineSubdivisionHomotopy_hom_succ`).

Both commute with the chain maps of affine maps between convex subsets of standard simplices
(`affineSubdivision_comp_chainComplexMap`,
`affineSubdivisionHomotopy_hom_comp_chainComplexMap`), because such maps preserve barycentres.
The subdivision of `σ` is an integer combination of subdivision simplices:
`ιChainComplex_affineSubdivision_mem_closure` puts it in the additive subgroup generated by the
generators of the simplices `τ` with `IsSubdivisionSimplex hK σ τ`, and
`comp_affineSubdivision_mem_closure` iterates this for `IsIteratedSubdivisionSimplex`.

`chainHomotopyOfSucc` builds a homotopy of `ℕ`-indexed chain complexes from its degreewise maps
`h n : P.X n ⟶ Q.X (n + 1)`.
-/

namespace TDA.Topology

open CategoryTheory Limits

/-- A homotopy between maps of `ℕ`-indexed chain complexes from its degreewise components
`h n : P.X n ⟶ Q.X (n + 1)`, given the homotopy identities in degree `0` and in positive degree. -/
noncomputable def chainHomotopyOfSucc {V : Type*} [Category* V] [Preadditive V]
    {P Q : ChainComplex V ℕ} {f g : P ⟶ Q} (h : ∀ n, P.X n ⟶ Q.X (n + 1))
    (h₀ : f.f 0 = h 0 ≫ Q.d 1 0 + g.f 0)
    (hs : ∀ n, f.f (n + 1) = P.d (n + 1) n ≫ h n + h (n + 1) ≫ Q.d (n + 2) (n + 1) + g.f (n + 1)) :
    Homotopy f g where
  hom i j := if hij : i + 1 = j then h i ≫ (Q.XIsoOfEq hij).hom else 0
  zero i j hij := dite_eq_right_iff.2 fun h => absurd h hij
  comm i := by
    cases i with
    | zero =>
      rw [Homotopy.dNext_zero_chainComplex, Homotopy.prevD_chainComplex, zero_add, h₀]
      simp
    | succ n =>
      rw [Homotopy.dNext_succ_chainComplex, Homotopy.prevD_chainComplex, hs n]
      simp

/-- The component of `chainHomotopyOfSucc` from degree `n` to degree `n + 1` is `h n`. -/
@[simp]
theorem chainHomotopyOfSucc_hom_succ {V : Type*} [Category* V] [Preadditive V]
    {P Q : ChainComplex V ℕ} {f g : P ⟶ Q} (h : ∀ n, P.X n ⟶ Q.X (n + 1))
    (h₀ : f.f 0 = h 0 ≫ Q.d 1 0 + g.f 0)
    (hs : ∀ n, f.f (n + 1) = P.d (n + 1) n ≫ h n + h (n + 1) ≫ Q.d (n + 2) (n + 1) + g.f (n + 1))
    (n : ℕ) :
    (chainHomotopyOfSucc h h₀ hs).hom n (n + 1) = h n := by
  simp [chainHomotopyOfSucc]

end TDA.Topology

namespace TDA.Topology.AffineChains

open CategoryTheory Limits Convexity Simplicial affineSSet

noncomputable section

universe u

section Augmentation

variable {D : Type*} [Category* D] [HasCoproducts.{u} D] [Preadditive D] (R : D)

/-- The augmentation vanishes on boundaries of `1`-chains. -/
@[reassoc (attr := simp)]
theorem d_comp_augmentation (S : SSet.{u}) : (S.chainComplex R).d 1 0 ≫ augmentation R S = 0 := by
  ext x
  simp [Fin.sum_univ_two]

end Augmentation

variable {m : ℕ} {K : Set (StdSimplex ℝ (Fin (m + 1)))} (hK : IsConvexSet ℝ K)
variable {C : Type*} [Category* C] [HasCoproducts.{u} C] [Preadditive C] (R : C)

/-! ### The subdivision chain map -/

/-- The degreewise barycentric subdivision `sd(σ) = b_σ · sd(∂σ)`. -/
private def subdivisionAux (n : ℕ) :
    ((affineSSet.{u} K).chainComplex R).X n ⟶ ((affineSSet.{u} K).chainComplex R).X n :=
  match n with
  | 0 => 𝟙 _
  | n + 1 => Cofan.IsColimit.desc ((affineSSet.{u} K).isColimitChainComplexXCofan R (n + 1))
      fun σ => (affineSSet.{u} K).ιChainComplex (R := R) σ ≫
        ((affineSSet.{u} K).chainComplex R).d (n + 1) n ≫ subdivisionAux n ≫
          coneMap.{u} R (simplexBarycenter hK (vertices σ)) n

@[reassoc]
private lemma ι_subdivisionAux_succ {n : ℕ} (σ : Fin (n + 2) → K) :
    (affineSSet.{u} K).ιChainComplex (R := R) (mk σ) ≫ subdivisionAux hK R (n + 1) =
      (affineSSet.{u} K).ιChainComplex (mk σ) ≫ ((affineSSet.{u} K).chainComplex R).d (n + 1) n ≫
        subdivisionAux hK R n ≫ coneMap.{u} R (simplexBarycenter hK σ) n :=
  Cofan.IsColimit.fac ((affineSSet.{u} K).isColimitChainComplexXCofan R (n + 1)) _ (mk σ)

private lemma subdivisionAux_zero : subdivisionAux.{u} hK R 0 = 𝟙 _ := rfl

@[reassoc]
private lemma subdivisionAux_d (n : ℕ) :
    subdivisionAux hK R (n + 1) ≫ ((affineSSet.{u} K).chainComplex R).d (n + 1) n =
      ((affineSSet.{u} K).chainComplex R).d (n + 1) n ≫ subdivisionAux hK R n := by
  induction n with
  | zero =>
    ext σ
    obtain ⟨σ, rfl⟩ : ∃ τ, mk τ = σ := ⟨vertices σ, rfl⟩
    rw [ι_subdivisionAux_succ_assoc, subdivisionAux_zero, Category.id_comp, coneMap_zero_d,
      Preadditive.comp_sub, Preadditive.comp_sub, Category.comp_id, d_comp_augmentation_assoc,
      zero_comp, comp_zero, sub_zero]
  | succ n ih =>
    ext σ
    obtain ⟨σ, rfl⟩ : ∃ τ, mk τ = σ := ⟨vertices σ, rfl⟩
    rw [ι_subdivisionAux_succ_assoc, coneMap_d, Preadditive.comp_sub, Preadditive.comp_sub,
      Category.comp_id, reassoc_of% ih, HomologicalComplex.d_comp_d_assoc, zero_comp, sub_zero]

/-- **Barycentric subdivision** of affine chains: the identity in degree `0` and
`sd(σ) = b_σ · sd(∂σ)` in positive degree, with `b_σ` the barycentre of `σ`. -/
def affineSubdivision :
    (affineSSet.{u} K).chainComplex R ⟶ (affineSSet.{u} K).chainComplex R where
  f := subdivisionAux hK R
  comm' i j hij := by
    obtain rfl : i = j + 1 := hij.symm
    exact subdivisionAux_d hK R j

/-- Barycentric subdivision is the identity in degree `0`. -/
@[simp]
theorem affineSubdivision_f_zero : (affineSubdivision.{u} hK R).f 0 = 𝟙 _ := rfl

/-- The recursion `sd(σ) = b_σ · sd(∂σ)` on a generator of positive degree. -/
@[reassoc]
theorem ιChainComplex_affineSubdivision_f_succ {n : ℕ} (σ : Fin (n + 2) → K) :
    (affineSSet.{u} K).ιChainComplex (R := R) (mk σ) ≫ (affineSubdivision hK R).f (n + 1) =
      (affineSSet.{u} K).ιChainComplex (mk σ) ≫ ((affineSSet.{u} K).chainComplex R).d (n + 1) n ≫
        (affineSubdivision hK R).f n ≫ coneMap.{u} R (simplexBarycenter hK σ) n :=
  ι_subdivisionAux_succ hK R σ

/-- The subdivision of a segment `[v₀, v₁]` is `[b, v₁] - [b, v₀]`, with `b` its midpoint. -/
theorem ιChainComplex_affineSubdivision_f_one (σ : Fin 2 → K) :
    (affineSSet.{u} K).ιChainComplex (R := R) (mk σ) ≫ (affineSubdivision hK R).f 1 =
      (affineSSet.{u} K).ιChainComplex (mk ![simplexBarycenter hK σ, σ 1]) -
        (affineSSet.{u} K).ιChainComplex (mk ![simplexBarycenter hK σ, σ 0]) := by
  rw [ιChainComplex_affineSubdivision_f_succ, affineSubdivision_f_zero, Category.id_comp,
    SSet.ιChainComplex_d_assoc, Fin.sum_univ_two]
  have h₀ : cone (simplexBarycenter hK σ) (σ ∘ (0 : Fin 2).succAbove) =
      ![simplexBarycenter hK σ, σ 1] := by
    funext j
    fin_cases j <;> rfl
  have h₁ : cone (simplexBarycenter hK σ) (σ ∘ (1 : Fin 2).succAbove) =
      ![simplexBarycenter hK σ, σ 0] := by
    funext j
    fin_cases j <;> rfl
  simp only [Fin.val_zero, pow_zero, one_smul, Fin.val_one, pow_one, neg_smul, δ_mk,
    Preadditive.add_comp, Preadditive.neg_comp, ιChainComplex_coneMap, h₀, h₁, sub_eq_add_neg]

/-! ### Naturality in affine maps -/

/-- Barycentric subdivision commutes with the chain map of an affine map of ambient simplices
carrying `K` into `K'`. -/
theorem affineSubdivision_comp_chainComplexMap {m' : ℕ} {K' : Set (StdSimplex ℝ (Fin (m' + 1)))}
    (hK' : IsConvexSet ℝ K')
    (F : ConvexSpace.AffineMap ℝ (StdSimplex ℝ (Fin (m + 1))) (StdSimplex ℝ (Fin (m' + 1))))
    (hF : Set.MapsTo F K K') :
    affineSubdivision hK R ≫ SSet.chainComplexMap (affineSSet.map.{u} (hF.restrict F K K')) R =
      SSet.chainComplexMap (affineSSet.map.{u} (hF.restrict F K K')) R ≫
        affineSubdivision hK' R := by
  ext n : 1
  simp only [HomologicalComplex.comp_f]
  induction n with
  | zero => simp
  | succ n ih =>
    ext σ
    obtain ⟨σ, rfl⟩ : ∃ τ, mk τ = σ := ⟨vertices σ, rfl⟩
    rw [ιChainComplex_affineSubdivision_f_succ_assoc, coneMap_comp_chainComplexMap,
      reassoc_of% ih, ← HomologicalComplex.Hom.comm_assoc, SSet.ι_chainComplexMap_f_assoc,
      map_app_mk, SSet.ι_chainComplexMap_f_assoc, map_app_mk,
      ιChainComplex_affineSubdivision_f_succ, simplexBarycenter_mapsTo hK hK' F hF]

/-! ### The subdivision as an integer combination of subdivision simplices -/

/-- The subdivision of an affine simplex `σ` is an integer combination of the simplices `τ` of
the barycentric subdivision of `σ` (`IsSubdivisionSimplex hK σ τ`). -/
theorem ιChainComplex_affineSubdivision_mem_closure {n : ℕ} (σ : Fin (n + 1) → K) :
    (affineSSet.{u} K).ιChainComplex (R := R) (mk σ) ≫ (affineSubdivision hK R).f n ∈
      AddSubgroup.closure {f | ∃ τ, IsSubdivisionSimplex hK σ τ ∧
        f = (affineSSet.{u} K).ιChainComplex (R := R) (mk τ)} := by
  induction n with
  | zero =>
    rw [affineSubdivision_f_zero, Category.comp_id]
    exact AddSubgroup.subset_closure ⟨σ, .vertex σ, rfl⟩
  | succ n ih =>
    rw [ιChainComplex_affineSubdivision_f_succ, SSet.ιChainComplex_d_assoc, Preadditive.sum_comp]
    refine sum_mem fun i _ => ?_
    rw [Preadditive.zsmul_comp]
    refine AddSubgroup.zsmul_mem _ ?_ _
    rw [δ_mk]
    have hle : AddSubgroup.closure {f | ∃ τ, IsSubdivisionSimplex hK (σ ∘ i.succAbove) τ ∧
        f = (affineSSet.{u} K).ιChainComplex (R := R) (mk τ)} ≤
        (AddSubgroup.closure {f | ∃ τ, IsSubdivisionSimplex hK σ τ ∧
          f = (affineSSet.{u} K).ιChainComplex (R := R) (mk τ)}).comap
          (Preadditive.rightComp _ (coneMap.{u} R (simplexBarycenter hK σ) n)) := by
      rw [AddSubgroup.closure_le]
      rintro _ ⟨τ, hτ, rfl⟩
      exact AddSubgroup.subset_closure ⟨_, .cone σ i hτ, ιChainComplex_coneMap _ _ _⟩
    rw [← Category.assoc]
    exact hle (ih (σ ∘ i.succAbove))

/-- One more subdivision step: an integer combination of simplices of the `N`-fold subdivision
of `σ` is carried by `affineSubdivision` to an integer combination of simplices of the
`(N + 1)`-fold subdivision of `σ`. -/
theorem comp_affineSubdivision_mem_closure {n N : ℕ} {σ : Fin (n + 1) → K}
    {f : R ⟶ ((affineSSet.{u} K).chainComplex R).X n}
    (hf : f ∈ AddSubgroup.closure {f | ∃ τ, IsIteratedSubdivisionSimplex hK N σ τ ∧
      f = (affineSSet.{u} K).ιChainComplex (R := R) (mk τ)}) :
    f ≫ (affineSubdivision hK R).f n ∈
      AddSubgroup.closure {f | ∃ τ, IsIteratedSubdivisionSimplex hK (N + 1) σ τ ∧
        f = (affineSSet.{u} K).ιChainComplex (R := R) (mk τ)} := by
  have hle : AddSubgroup.closure {f | ∃ τ, IsIteratedSubdivisionSimplex hK N σ τ ∧
      f = (affineSSet.{u} K).ιChainComplex (R := R) (mk τ)} ≤
      (AddSubgroup.closure {f | ∃ τ, IsIteratedSubdivisionSimplex hK (N + 1) σ τ ∧
        f = (affineSSet.{u} K).ιChainComplex (R := R) (mk τ)}).comap
        (Preadditive.rightComp _ ((affineSubdivision hK R).f n)) := by
    rw [AddSubgroup.closure_le]
    rintro _ ⟨τ, hτ, rfl⟩
    refine AddSubgroup.closure_mono ?_ (ιChainComplex_affineSubdivision_mem_closure hK R τ)
    rintro _ ⟨ρ, hρ, rfl⟩
    exact ⟨ρ, .succ hτ hρ, rfl⟩
  exact hle hf

/-! ### The homotopy to the identity -/

/-- The degreewise homotopy `T(σ) = b_σ · (sd(σ) - σ - T(∂σ))`, with `T = 0` in degree `0`. -/
private def homotopyAux (n : ℕ) :
    ((affineSSet.{u} K).chainComplex R).X n ⟶ ((affineSSet.{u} K).chainComplex R).X (n + 1) :=
  match n with
  | 0 => 0
  | n + 1 => Cofan.IsColimit.desc ((affineSSet.{u} K).isColimitChainComplexXCofan R (n + 1))
      fun σ => ((affineSSet.{u} K).ιChainComplex (R := R) σ ≫
          ((affineSubdivision hK R).f (n + 1) - 𝟙 _) -
          (affineSSet.{u} K).ιChainComplex (R := R) σ ≫
            ((affineSSet.{u} K).chainComplex R).d (n + 1) n ≫ homotopyAux n) ≫
        coneMap.{u} R (simplexBarycenter hK (vertices σ)) (n + 1)

@[reassoc]
private lemma ι_homotopyAux_succ {n : ℕ} (σ : Fin (n + 2) → K) :
    (affineSSet.{u} K).ιChainComplex (R := R) (mk σ) ≫ homotopyAux hK R (n + 1) =
      ((affineSSet.{u} K).ιChainComplex (R := R) (mk σ) ≫
          ((affineSubdivision hK R).f (n + 1) - 𝟙 _) -
          (affineSSet.{u} K).ιChainComplex (R := R) (mk σ) ≫
            ((affineSSet.{u} K).chainComplex R).d (n + 1) n ≫ homotopyAux hK R n) ≫
        coneMap.{u} R (simplexBarycenter hK σ) (n + 1) :=
  Cofan.IsColimit.fac ((affineSSet.{u} K).isColimitChainComplexXCofan R (n + 1)) _ (mk σ)

private lemma homotopyAux_zero : homotopyAux.{u} hK R 0 = 0 := rfl

/-- The homotopy identity in degree `n + 1`, given `∂ T ∂ = ∂ (sd - 1)` in degree `n`. -/
private lemma homotopyAux_spec_of {n : ℕ}
    (h : ((affineSSet.{u} K).chainComplex R).d (n + 1) n ≫ homotopyAux hK R n ≫
        ((affineSSet.{u} K).chainComplex R).d (n + 1) n =
      ((affineSSet.{u} K).chainComplex R).d (n + 1) n ≫ ((affineSubdivision hK R).f n - 𝟙 _)) :
    ((affineSSet.{u} K).chainComplex R).d (n + 1) n ≫ homotopyAux hK R n +
        homotopyAux hK R (n + 1) ≫ ((affineSSet.{u} K).chainComplex R).d (n + 2) (n + 1) =
      (affineSubdivision hK R).f (n + 1) - 𝟙 _ := by
  ext σ
  obtain ⟨σ, rfl⟩ : ∃ τ, mk τ = σ := ⟨vertices σ, rfl⟩
  have hc : ((affineSSet.{u} K).ιChainComplex (R := R) (mk σ) ≫
        ((affineSubdivision hK R).f (n + 1) - 𝟙 _) -
        (affineSSet.{u} K).ιChainComplex (R := R) (mk σ) ≫
          ((affineSSet.{u} K).chainComplex R).d (n + 1) n ≫ homotopyAux hK R n) ≫
      ((affineSSet.{u} K).chainComplex R).d (n + 1) n = 0 := by
    have hcomm := (affineSubdivision hK R).comm (n + 1) n
    simp only [Preadditive.sub_comp, Preadditive.comp_sub, Category.assoc, Category.comp_id, h,
      hcomm, sub_self]
  rw [Preadditive.comp_add, ι_homotopyAux_succ_assoc, coneMap_d, Preadditive.comp_sub,
    Category.comp_id, reassoc_of% hc, zero_comp, sub_zero]
  abel

private lemma homotopyAux_spec (n : ℕ) :
    ((affineSSet.{u} K).chainComplex R).d (n + 1) n ≫ homotopyAux hK R n +
        homotopyAux hK R (n + 1) ≫ ((affineSSet.{u} K).chainComplex R).d (n + 2) (n + 1) =
      (affineSubdivision hK R).f (n + 1) - 𝟙 _ := by
  induction n with
  | zero =>
    refine homotopyAux_spec_of hK R ?_
    rw [homotopyAux_zero, zero_comp, comp_zero, affineSubdivision_f_zero, sub_self,
      comp_zero]
  | succ n ih =>
    refine homotopyAux_spec_of hK R ?_
    rw [← sub_eq_iff_eq_add'.mpr ih.symm, Preadditive.comp_sub, Preadditive.comp_sub,
      HomologicalComplex.d_comp_d_assoc, zero_comp, sub_zero]

/-- The **subdivision homotopy** `T` from `affineSubdivision hK R` to the identity:
`T = 0` in degree `0` and `T(σ) = b_σ · (sd(σ) - σ - T(∂σ))` in positive degree. -/
def affineSubdivisionHomotopy : Homotopy (affineSubdivision.{u} hK R) (𝟙 _) :=
  chainHomotopyOfSucc (homotopyAux hK R)
    (by simp [homotopyAux_zero])
    (fun n => by
      rw [HomologicalComplex.id_f, homotopyAux_spec, sub_add_cancel])

private lemma affineSubdivisionHomotopy_hom_eq (n : ℕ) :
    (affineSubdivisionHomotopy.{u} hK R).hom n (n + 1) = homotopyAux hK R n :=
  chainHomotopyOfSucc_hom_succ _ _ _ n

/-- The subdivision homotopy vanishes in degree `0`. -/
@[simp]
theorem affineSubdivisionHomotopy_hom_zero :
    (affineSubdivisionHomotopy.{u} hK R).hom 0 1 = 0 :=
  affineSubdivisionHomotopy_hom_eq hK R 0

/-- The recursion `T(σ) = b_σ · (sd(σ) - σ - T(∂σ))` on a generator of positive degree. -/
@[reassoc]
theorem ιChainComplex_affineSubdivisionHomotopy_hom_succ {n : ℕ} (σ : Fin (n + 2) → K) :
    (affineSSet.{u} K).ιChainComplex (R := R) (mk σ) ≫
        (affineSubdivisionHomotopy hK R).hom (n + 1) (n + 2) =
      ((affineSSet.{u} K).ιChainComplex (R := R) (mk σ) ≫
          ((affineSubdivision hK R).f (n + 1) - 𝟙 _) -
          (affineSSet.{u} K).ιChainComplex (R := R) (mk σ) ≫
            ((affineSSet.{u} K).chainComplex R).d (n + 1) n ≫
              (affineSubdivisionHomotopy hK R).hom n (n + 1)) ≫
        coneMap.{u} R (simplexBarycenter hK σ) (n + 1) := by
  rw [affineSubdivisionHomotopy_hom_eq hK R (n + 1), affineSubdivisionHomotopy_hom_eq hK R n]
  exact ι_homotopyAux_succ hK R σ

/-- The subdivision homotopy commutes with the chain map of an affine map of ambient simplices
carrying `K` into `K'`. -/
theorem affineSubdivisionHomotopy_hom_comp_chainComplexMap {m' : ℕ}
    {K' : Set (StdSimplex ℝ (Fin (m' + 1)))} (hK' : IsConvexSet ℝ K')
    (F : ConvexSpace.AffineMap ℝ (StdSimplex ℝ (Fin (m + 1))) (StdSimplex ℝ (Fin (m' + 1))))
    (hF : Set.MapsTo F K K') (n : ℕ) :
    (affineSubdivisionHomotopy hK R).hom n (n + 1) ≫
        (SSet.chainComplexMap (affineSSet.map.{u} (hF.restrict F K K')) R).f (n + 1) =
      (SSet.chainComplexMap (affineSSet.map.{u} (hF.restrict F K K')) R).f n ≫
        (affineSubdivisionHomotopy hK' R).hom n (n + 1) := by
  have hsd := HomologicalComplex.congr_hom (affineSubdivision_comp_chainComplexMap hK R hK' F hF)
  simp only [HomologicalComplex.comp_f] at hsd
  induction n with
  | zero => simp
  | succ n ih =>
    ext σ
    obtain ⟨σ, rfl⟩ : ∃ τ, mk τ = σ := ⟨vertices σ, rfl⟩
    rw [ιChainComplex_affineSubdivisionHomotopy_hom_succ_assoc, coneMap_comp_chainComplexMap,
      SSet.ι_chainComplexMap_f_assoc, map_app_mk, ιChainComplex_affineSubdivisionHomotopy_hom_succ,
      simplexBarycenter_mapsTo hK hK' F hF]
    rw [← Category.assoc]
    refine congrArg (· ≫ coneMap.{u} R _ (n + 1)) ?_
    simp only [Preadditive.sub_comp, Preadditive.comp_sub, Category.assoc, Category.comp_id, hsd,
      ih,
      ← (SSet.chainComplexMap (affineSSet.map.{u} (hF.restrict F K K')) R).comm_assoc,
      SSet.ι_chainComplexMap_f_assoc, SSet.ι_chainComplexMap_f, map_app_mk]

end

end TDA.Topology.AffineChains
