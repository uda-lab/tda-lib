import TDA.Persistence.PrincipalDownsetInjective
import TDA.Persistence.GeneratedUpsetQuotientFiniteResolution
import Mathlib.Order.Minimal

/-!
# Rank-projective resolutions of principal downsets

The complement of a principal downset in a finite lattice is generated by its
minimal elements. Enumerating these actual endpoints identifies the existing
hook-quotient resolution with the principal-downset module. The top downset is
handled by its isomorphism with the free hook born at bottom and an identity row.
This is the principal-downset construction in BOOS, arXiv:2208.00300v3,
Proposition 5.14, with complement generators as in Notation 5.2.
-/

set_option autoImplicit false

universe u

namespace TDA.Persistence.PrincipalDownsetRankResolution

open CategoryTheory CategoryTheory.Limits
open scoped Classical

variable {S : Type} [Lattice S] [Finite S] [OrderBot S] [OrderTop S]

/-- The minimal elements of the complement of the principal downset. -/
def minimalComplement (p : S) : Set S := {a | Minimal (fun x => ¬ x ≤ p) a}

omit [OrderBot S] [OrderTop S] in
/-- Every point outside the downset lies above a minimal complement element. -/
theorem not_le_iff_exists_minimalComplement (p q : S) :
    ¬ q ≤ p ↔ ∃ a ∈ minimalComplement p, a ≤ q := by
  constructor
  · intro hq
    obtain ⟨a, haq, ha⟩ := exists_minimal_le_of_wellFoundedLT (fun x => ¬ x ≤ p) q hq
    exact ⟨a, ha, haq⟩
  · rintro ⟨a, ha, haq⟩ hq
    exact (show Minimal (fun x => ¬ x ≤ p) a from ha).prop (haq.trans hq)

omit [OrderBot S] in
/-- The complement has no minimal elements precisely at the top downset. -/
@[simp] theorem minimalComplement_eq_empty_iff (p : S) :
    minimalComplement p = ∅ ↔ p = ⊤ := by
  constructor
  · intro h
    apply top_le_iff.mp
    by_contra hp
    obtain ⟨a, ha, _⟩ := (not_le_iff_exists_minimalComplement p ⊤).mp hp
    simp [h] at ha
  · rintro rfl
    ext a
    simp [minimalComplement, Minimal]

noncomputable instance minimalComplementFintype (p : S) : Fintype (minimalComplement p) :=
  Fintype.ofFinite _

/-- The number of minimal generators of the complement. -/
noncomputable def complementCard (p : S) : ℕ := Fintype.card (minimalComplement p)

/-- An enumeration of the actual minimal complement endpoints. -/
noncomputable def complementEnumeration (p : S) : Fin (complementCard p) → S :=
  fun i => ((Fintype.equivFin (minimalComplement p)).symm i).val

omit [OrderBot S] [OrderTop S] in
/-- The enumeration has exactly the minimal complement as its range. -/
theorem range_complementEnumeration (p : S) :
    Set.range (complementEnumeration p) = minimalComplement p := by
  ext a
  constructor
  · rintro ⟨i, rfl⟩
    exact ((Fintype.equivFin (minimalComplement p)).symm i).property
  · intro ha
    refine ⟨Fintype.equivFin (minimalComplement p) ⟨a, ha⟩, ?_⟩
    simp [complementEnumeration]

omit [OrderBot S] [OrderTop S] in
/-- The endpoint enumeration has no repeated occurrences. -/
theorem complementEnumeration_injective (p : S) :
    Function.Injective (complementEnumeration p) :=
  Subtype.coe_injective.comp (Fintype.equivFin (minimalComplement p)).symm.injective

omit [OrderBot S] in
@[simp] theorem complementCard_eq_zero_iff (p : S) : complementCard p = 0 ↔ p = ⊤ := by
  rw [complementCard, Fintype.card_eq_zero_iff]
  rw [Set.isEmpty_coe_sort, minimalComplement_eq_empty_iff]

omit [OrderBot S] [OrderTop S] in
/-- The complement of the generated upset is the original principal downset. -/
theorem complementSupport_eq (p : S) :
    GeneratedUpsetQuotientResolution.complementSupport (complementEnumeration p) = Set.Iic p := by
  ext q
  change (¬ ∃ i, complementEnumeration p i ≤ q) ↔ q ≤ p
  have hgen : (∃ i, complementEnumeration p i ≤ q) ↔ ¬ q ≤ p := by
    rw [not_le_iff_exists_minimalComplement]
    constructor
    · rintro ⟨i, hi⟩
      exact ⟨_, (range_complementEnumeration p).le ⟨i, rfl⟩, hi⟩
    · rintro ⟨a, ha, haq⟩
      obtain ⟨i, rfl⟩ := (range_complementEnumeration p).symm.le ha
      exact ⟨i, haq⟩
  rw [hgen, not_not]

variable {k : Type u} [Field k]

/-- Support identification for the principal-downset target, preserving its maps. -/
noncomputable def complementIso (p : S) :
    SupportInterval.module (k := k)
      (GeneratedUpsetQuotientResolution.complementSupport (complementEnumeration p))
      (GeneratedUpsetQuotientResolution.complementSupport_ordConnected _) ≅
        PrincipalDownsetInjective.module p :=
  eqToIso (by simp only [PrincipalDownsetInjective.module, complementSupport_eq])

/-- For a nonempty complement, transport the actual quotient resolution. -/
noncomputable def nonTopResolution (p : S) (hp : 0 < complementCard p) :
    FiniteRankProjectiveResolution (PrincipalDownsetInjective.module (k := k) p) :=
  (GeneratedUpsetQuotientFiniteResolution.complementResolution
    (k := k) (complementEnumeration p) hp).ofIso (complementIso p)

omit [OrderTop S] in
@[simp] theorem nonTopResolution_length (p : S) (hp : 0 < complementCard p) :
    (nonTopResolution (k := k) p hp).length = complementCard p := rfl

omit [OrderTop S] in
/-- The transported terms are the same occurrence-indexed hook quotients. -/
@[simp] theorem nonTopResolution_term (p : S) (hp : 0 < complementCard p)
    (i : Fin (complementCard p)) :
    (nonTopResolution (k := k) p hp).term i =
      GeneratedUpsetQuotientResolution.term (k := k) (complementEnumeration p) i.val := rfl

/-- Each recorded term retains the face-indexed hook-sum description. -/
noncomputable def nonTopResolution_termHookSumIso (p : S) (hp : 0 < complementCard p)
    (i : Fin (complementCard p)) :
    (nonTopResolution (k := k) p hp).term i ≅
      ⨁ (fun A : GeneratedUpsetResolution.FaceIndex (complementCard p) i.val =>
        Hook.module (k := k) ⊥ (GeneratedUpsetResolution.faceJoin (complementEnumeration p) A)) :=
  GeneratedUpsetQuotientResolution.hookSumIso (complementEnumeration p) i.val

omit [OrderTop S] in
/-- The initial quotient is the existing augmentation under the support identification. -/
@[reassoc] theorem nonTopResolution_augmentation (p : S) (hp : 0 < complementCard p) :
    (nonTopResolution (k := k) p hp).quotient ⟨0, hp⟩ ≫
      (nonTopResolution (k := k) p hp).initial_iso.hom =
    GeneratedUpsetQuotientResolution.augmentation (k := k) (complementEnumeration p) ≫
      (GeneratedUpsetQuotientResolution.targetIso (k := k) (complementEnumeration p) hp).hom ≫
        (complementIso p).hom := by
  simp [nonTopResolution, FiniteRankProjectiveResolution.ofIso,
    GeneratedUpsetQuotientFiniteResolution.complementResolution,
    GeneratedUpsetQuotientFiniteResolution.resolution,
    GeneratedUpsetQuotientFiniteResolution.kernelAt]

omit [OrderTop S] in
/-- On the original constant-bottom resolution, the transported augmentation is
exactly the complement coefficient projection followed by the support identification. -/
@[reassoc] theorem nonTopResolution_augmentation_projection (p : S)
    (hp : 0 < complementCard p) :
    cokernel.π (GeneratedUpsetQuotientResolution.inclusion (k := k) (complementEnumeration p) 0) ≫
      ((nonTopResolution (k := k) p hp).quotient ⟨0, hp⟩ ≫
        (nonTopResolution (k := k) p hp).initial_iso.hom) =
    GeneratedUpsetResolution.augmentation
      (GeneratedUpsetQuotientResolution.bottomFamily (complementCard p)) ≫
        GeneratedUpsetQuotientResolution.targetProjection (k := k) (complementEnumeration p) hp ≫
          (complementIso p).hom := by
  change cokernel.π (GeneratedUpsetQuotientResolution.inclusion (k := k)
    (complementEnumeration p) 0) ≫
      (GeneratedUpsetQuotientResolution.augmentation (k := k) (complementEnumeration p) ≫
        (GeneratedUpsetQuotientResolution.targetIso (k := k) (complementEnumeration p) hp).hom ≫
          (complementIso p).hom) = _
  rw [← Category.assoc, GeneratedUpsetQuotientResolution.projection_augmentation]
  simp only [Category.assoc, GeneratedUpsetQuotientResolution.projection_targetIso_assoc]

private noncomputable def topFiberEquiv (q : S) :
    (PrincipalDownsetInjective.module (k := k) (⊤ : S)).obj q ≃ₗ[k] k where
  toFun x := x.val
  invFun x := ⟨x, by simp [SupportInterval.fiber]⟩
  left_inv x := rfl
  right_inv x := rfl
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

/-- The top downset is the constant scalar module, with coefficient-preserving maps. -/
noncomputable def topConstantIso :
    PrincipalDownsetInjective.module (k := k) (⊤ : S) ≅
      (Functor.const S).obj (ModuleCat.of k k) :=
  NatIso.ofComponents (fun q => (topFiberEquiv (k := k) q).toModuleIso) (by
    intro q r f
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    change (structureMapLinear (PrincipalDownsetInjective.module (⊤ : S)) (leOfHom f) x : k) = (x : k)
    rw [SupportInterval.structureMap_val]
    simp)

/-- The constant scalar module is the free principal-upset hook born at bottom. -/
noncomputable def constantHookIso :
    (Functor.const S).obj (ModuleCat.of k k) ≅ HookInfinity.module (R := k) (⊥ : S) :=
  NatIso.ofComponents
    (fun q => (HookInfinity.fiberEquivOfLe (R := k) (bot_le : (⊥ : S) ≤ q)).symm.toModuleIso)
    (by
      intro q r f
      apply ModuleCat.hom_ext
      apply LinearMap.ext
      intro x
      apply (HookInfinity.fiberEquivOfLe (R := k) (bot_le : (⊥ : S) ≤ r)).injective
      change HookInfinity.fiberEquivOfLe (R := k) (bot_le : (⊥ : S) ≤ r)
        ((HookInfinity.fiberEquivOfLe (R := k) (bot_le : (⊥ : S) ≤ r)).symm x) =
        HookInfinity.fiberEquivOfLe (R := k) (bot_le : (⊥ : S) ≤ r)
          (structureMapLinear _ (leOfHom f)
            ((HookInfinity.fiberEquivOfLe (R := k) (bot_le : (⊥ : S) ≤ q)).symm x))
      rw [HookInfinity.fiberEquivOfLe_structureMap (bot_le : (⊥ : S) ≤ q)]
      simp only [LinearEquiv.apply_symm_apply])

/-- The top principal downset is the actual bottom-born projective hook. -/
noncomputable def topHookIso :
    PrincipalDownsetInjective.module (k := k) (⊤ : S) ≅ HookInfinity.module (R := k) (⊥ : S) :=
  topConstantIso ≪≫ constantHookIso

omit [Finite S] in
/-- The top-downset to hook isomorphism preserves the actual scalar coefficient. -/
@[simp] theorem topHookIso_hom_coefficient (q : S)
    (x : (PrincipalDownsetInjective.module (k := k) (⊤ : S)).obj q) :
    HookInfinity.fiberEquivOfLe (R := k) (bot_le : (⊥ : S) ≤ q)
      (((topHookIso (k := k) (S := S)).hom.app q).hom x) = (x : k) := by
  change HookInfinity.fiberEquivOfLe (R := k) (bot_le : (⊥ : S) ≤ q)
    ((HookInfinity.fiberEquivOfLe (R := k) (bot_le : (⊥ : S) ≤ q)).symm (x : k)) = _
  exact LinearEquiv.apply_symm_apply _ _

omit [Finite S] in
/-- The top principal downset is rank projective. -/
theorem top_rankProjective :
    IsRankProjective (PrincipalDownsetInjective.module (k := k) (⊤ : S)) :=
  (HookInfinity.isRankProjective (k := k) (⊥ : S)).of_iso topHookIso.symm

/-- The actual one-term identity resolution of the top downset. -/
noncomputable def topResolution :
    FiniteRankProjectiveResolution (PrincipalDownsetInjective.module (k := k) (⊤ : S)) :=
  .ofRankProjective _ (fun q => PrincipalDownsetInjective.finiteDimensional ⊤ q)
    top_rankProjective

omit [Finite S] in
@[simp] theorem topResolution_length : (topResolution (k := k) (S := S)).length = 1 := rfl

omit [Finite S] in
/-- The single recorded top term is the downset module itself. -/
@[simp] theorem topResolution_term (i : Fin 1) :
    (topResolution (k := k) (S := S)).term i = PrincipalDownsetInjective.module (⊤ : S) := rfl

omit [Finite S] in
/-- The top resolution's augmentation is exactly the identity. -/
@[simp] theorem topResolution_augmentation :
    (topResolution (k := k) (S := S)).quotient ⟨0, by rw [topResolution_length]; decide⟩ ≫
      (topResolution (k := k) (S := S)).initial_iso.hom =
        𝟙 (PrincipalDownsetInjective.module (k := k) (⊤ : S)) := by
  change 𝟙 _ ≫ 𝟙 _ = _
  simp

/-- Every principal downset has a finite rank-projective resolution. -/
noncomputable def resolution (p : S) :
    FiniteRankProjectiveResolution (PrincipalDownsetInjective.module (k := k) p) := by
  classical
  exact if hp : p = ⊤ then topResolution.ofIso (eqToIso (by rw [hp]))
    else nonTopResolution p (Nat.pos_of_ne_zero (fun h => hp ((complementCard_eq_zero_iff p).mp h)))

/-- The chosen resolution records one term at top and otherwise one per complement generator. -/
@[simp] theorem resolution_length (p : S) :
    (resolution (k := k) p).length = max 1 (complementCard p) := by
  classical
  by_cases hp : p = ⊤
  · subst p
    rw [show complementCard (⊤ : S) = 0 from (complementCard_eq_zero_iff _).mpr rfl]
    simp only [resolution]
    rfl
  · have hc : 0 < complementCard p := Nat.pos_of_ne_zero
      (fun h => hp ((complementCard_eq_zero_iff p).mp h))
    rw [resolution, dif_neg hp, nonTopResolution_length]
    exact (max_eq_right (Nat.succ_le_of_lt hc)).symm

end TDA.Persistence.PrincipalDownsetRankResolution
