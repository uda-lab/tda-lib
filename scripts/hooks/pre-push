#!/usr/bin/env bash
# Local push gate (enable once per clone: scripts/bootstrap.sh, or
# `git config core.hooksPath scripts/hooks`). Fails fast:
#   1. the tip commit of every pushed ref has a tree free of transient/prohibited artefacts
#      and of merge-conflict markers;
#   2. no unmarked sorry/admit, no custom axiom/opaque/unsafe in the working tree, and the
#      root and area aggregators are imports-only;
#   3. if Lean sources, build config or comparator.json changed, the applicable local gate
#      must pass: scripts/check.sh --stable (the full gate) in a stable context — pushing
#      from a `main` checkout, e.g. a release tag, or TDA_STABLE_RELEASE=1 — since check.sh
#      itself rejects --incremental together with stable mode (exit 64); scripts/check.sh
#      --incremental otherwise (resource-guarded lake build + selectively re-audited
#      axioms/coverage/Comparator, falling back to the full gate when eligibility cannot be
#      established — Issue #951). The incremental gate's own output never reads `CHECK OK`:
#      it is feedback, not merge evidence. The full gate stays authoritative in hosted CI.
# The build log stays in a temp file; only its tail is printed on failure, so full
# Lean logs never enter an agent's context.
set -uo pipefail
ROOT="$(git rev-parse --show-toplevel)" || exit 1
cd "$ROOT" || exit 1
export PATH="$HOME/.elan/bin:$PATH"

# Collect the pushed commits and the set of changed files from the refs git supplies
# on stdin (format: <local-ref> <local-oid> <remote-ref> <remote-oid>).
# Fallback to HEAD-vs-origin/develop when stdin is empty (manual invocation).
integration=origin/develop
# Bootstrap before develop exists still compares against the template main revision.
if ! git rev-parse --verify "$integration" >/dev/null 2>&1; then integration=origin/main; fi
z40="0000000000000000000000000000000000000000"
changed=""
oids=""
had_input=0
while read -r local_ref local_oid remote_ref remote_oid; do
  had_input=1
  [ -z "${local_oid:-}" ] && continue
  [ "$local_oid" = "$z40" ] && continue                     # deleting a ref — nothing to check
  oids+="$local_oid"$'\n'
  if [ "$remote_oid" = "$z40" ]; then                       # new remote branch
    rbase="$(git merge-base "$local_oid" "$integration" 2>/dev/null || true)"
  else
    rbase="$remote_oid"
  fi
  if [ -n "${rbase:-}" ]; then
    changed+="$(git diff --name-only "$rbase" "$local_oid" 2>/dev/null)"$'\n'
  else
    changed+="$(git diff --name-only "$local_oid" 2>/dev/null)"$'\n'
  fi
done
if [ "$had_input" = "0" ]; then
  oids="$(git rev-parse HEAD)"$'\n'
  base="$(git merge-base HEAD "$integration" 2>/dev/null || true)"
  changed="$(git diff --name-only "${base:-HEAD}" HEAD 2>/dev/null || true)"
fi

echo "[pre-push] transient-artefact and conflict-marker guards on pushed commits…"
for oid in $oids; do
  bash scripts/check-transient-artifacts.sh "$oid" \
    || { echo "[pre-push] BLOCK: check-transient-artifacts failed for $oid"; exit 1; }
  bash scripts/check-conflict-markers.sh "$oid" \
    || { echo "[pre-push] BLOCK: check-conflict-markers failed for $oid"; exit 1; }
done

echo "[pre-push] textual guards…"
bash scripts/check-no-sorry.sh        || { echo "[pre-push] BLOCK: check-no-sorry failed";        exit 1; }
bash scripts/check-no-custom-axiom.sh || { echo "[pre-push] BLOCK: check-no-custom-axiom failed"; exit 1; }
bash scripts/check-root-aggregator.sh || { echo "[pre-push] BLOCK: check-root-aggregator failed"; exit 1; }
bash scripts/check-no-bare-mathlib-import.sh || { echo "[pre-push] BLOCK: check-no-bare-mathlib-import failed"; exit 1; }

if printf '%s\n' "$changed" | grep -qE '\.lean$|lakefile|lean-toolchain|lake-manifest|comparator\.json'; then
  # scripts/check.sh rejects --incremental together with stable mode (exit 64): stable mode is
  # implied by TDA_STABLE_RELEASE=1 or pushing from a `main` checkout (e.g. a release tag push),
  # exactly the conditions check.sh itself auto-detects. An unconditional --incremental call
  # here would then block every such push outright, including one with an already-passing full
  # stable check, since the hook never even reaches scripts/check.sh's own logic to notice.
  # Stable contexts therefore select the full stable gate explicitly; everything else keeps the
  # incremental gate.
  stable_push=0
  if [ "${TDA_STABLE_RELEASE:-0}" = 1 ] || [ "$(git branch --show-current)" = main ]; then
    stable_push=1
  fi
  LOG="$(mktemp)"
  if [ "$stable_push" = 1 ]; then
    echo "[pre-push] Lean sources or build config changed, stable context (main or TDA_STABLE_RELEASE=1) — running scripts/check.sh --stable (resource-guarded)…"
    if ! bash scripts/check.sh --stable >"$LOG" 2>&1; then
      echo "[pre-push] BLOCK: scripts/check.sh --stable FAILED. Tail:"
      tail -n 40 "$LOG"
      rm -f "$LOG"
      exit 1
    fi
    rm -f "$LOG"
    echo "[pre-push] check.sh --stable green"
  else
    echo "[pre-push] Lean sources or build config changed — running scripts/check.sh --incremental (resource-guarded)…"
    if ! bash scripts/check.sh --incremental >"$LOG" 2>&1; then
      echo "[pre-push] BLOCK: scripts/check.sh --incremental FAILED. Tail:"
      tail -n 40 "$LOG"
      rm -f "$LOG"
      exit 1
    fi
    rm -f "$LOG"
    echo "[pre-push] check.sh --incremental green"
  fi
else
  echo "[pre-push] no Lean/build changes — build skipped"
fi
echo "[pre-push] gate passed"
exit 0
