#!/usr/bin/env bash
# Local push gate (enable once per clone: scripts/bootstrap.sh, or
# `git config core.hooksPath scripts/hooks`). Fails fast:
#   1. every pushed commit's tree is free of transient/prohibited artefacts;
#   2. no unmarked sorry/admit, no custom axiom/opaque/unsafe in the working tree, and the
#      root and area aggregators are imports-only;
#   3. if Lean sources or build config changed, the full gate (scripts/check.sh:
#      resource-guarded lake build + live axiom audit) must pass.
# The build log stays in a temp file; only its tail is printed on failure, so full
# Lean logs never enter an agent's context.
set -uo pipefail
ROOT="$(git rev-parse --show-toplevel)" || exit 1
cd "$ROOT" || exit 1
export PATH="$HOME/.elan/bin:$PATH"

# Collect the pushed commits and the set of changed files from the refs git supplies
# on stdin (format: <local-ref> <local-oid> <remote-ref> <remote-oid>).
# Fallback to HEAD-vs-origin/develop when stdin is empty (manual invocation).
integration=origin/develop
# Bootstrap before develop exists still compares against the template main revision.
if ! git rev-parse --verify "$integration" >/dev/null 2>&1; then integration=origin/main; fi
z40="0000000000000000000000000000000000000000"
changed=""
oids=""
had_input=0
while read -r local_ref local_oid remote_ref remote_oid; do
  had_input=1
  [ -z "${local_oid:-}" ] && continue
  [ "$local_oid" = "$z40" ] && continue                     # deleting a ref — nothing to check
  oids+="$local_oid"$'\n'
  if [ "$remote_oid" = "$z40" ]; then                       # new remote branch
    rbase="$(git merge-base "$local_oid" "$integration" 2>/dev/null || true)"
  else
    rbase="$remote_oid"
  fi
  if [ -n "${rbase:-}" ]; then
    changed+="$(git diff --name-only "$rbase" "$local_oid" 2>/dev/null)"$'\n'
  else
    changed+="$(git diff --name-only "$local_oid" 2>/dev/null)"$'\n'
  fi
done
if [ "$had_input" = "0" ]; then
  oids="$(git rev-parse HEAD)"$'\n'
  base="$(git merge-base HEAD "$integration" 2>/dev/null || true)"
  changed="$(git diff --name-only "${base:-HEAD}" HEAD 2>/dev/null || true)"
fi

echo "[pre-push] transient-artefact guard on pushed commits…"
for oid in $oids; do
  bash scripts/check-transient-artifacts.sh "$oid" \
    || { echo "[pre-push] BLOCK: check-transient-artifacts failed for $oid"; exit 1; }
done

echo "[pre-push] textual guards…"
bash scripts/check-no-sorry.sh        || { echo "[pre-push] BLOCK: check-no-sorry failed";        exit 1; }
bash scripts/check-no-custom-axiom.sh || { echo "[pre-push] BLOCK: check-no-custom-axiom failed"; exit 1; }
bash scripts/check-root-aggregator.sh || { echo "[pre-push] BLOCK: check-root-aggregator failed"; exit 1; }

if printf '%s\n' "$changed" | grep -qE '\.lean$|lakefile|lean-toolchain|lake-manifest'; then
  echo "[pre-push] Lean sources or build config changed — running scripts/check.sh (resource-guarded)…"
  LOG="$(mktemp)"
  if ! bash scripts/check.sh >"$LOG" 2>&1; then
    echo "[pre-push] BLOCK: scripts/check.sh FAILED. Tail:"
    tail -n 40 "$LOG"
    rm -f "$LOG"
    exit 1
  fi
  rm -f "$LOG"
  echo "[pre-push] check.sh green"
else
  echo "[pre-push] no Lean/build changes — build skipped"
fi
echo "[pre-push] gate passed"
exit 0
